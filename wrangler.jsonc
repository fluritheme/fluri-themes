{
  "name": "fluri-themes",
  "main": "workers/site.ts",
  "account_id": "b1daed2b24d520cf26a5ea50571cb1a3",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "fluri.xyz", "custom_domain": true }],
  "services": [{ "binding": "WINTER", "service": "fluri" }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
