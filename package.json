{
  "name": "fluri-themes-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5200",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:browser",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@fluritheme/fluri": "0.2.0",
    "@fluritheme/spider": "0.1.4"
  }
}
